# Leave empty for local development: the Vite dev server proxies /api and
# /uploads to the backend (see vite.config.js), so the app works from phones
# and other devices on your network via the dev server's LAN address.
# Set this only if the frontend is hosted separately from the API, e.g.
# VITE_API_URL=https://your-api-host.example.com
VITE_API_URL=
