@model EventSphere.Web.Models.Invoice
@{
    ViewData["Title"] = "Record Payment";
}

<div class="page-heading">
    <h1>Record Payment - @Model.InvoiceNumber</h1>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back</a>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="stat-card mb-3">
            <div class="stat-label">Total Amount</div>
            <div class="stat-value">@StatusHelper.Money(Model.Amount)</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card mb-3">
            <div class="stat-label">Already Paid</div>
            <div class="stat-value text-success">@StatusHelper.Money(Model.PaidAmount)</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card mb-3">
            <div class="stat-label">Balance Due</div>
            <div class="stat-value text-danger">@StatusHelper.Money(Model.Balance)</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="RecordPayment" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Payment Amount</label>
                    <input type="number" step="0.01" min="0" max="@Model.Balance" name="amount" class="form-control" required />
                </div>
            </div>
            <button type="submit" class="btn btn-success mt-3">Record Payment</button>
        </form>
    </div>
</div>
