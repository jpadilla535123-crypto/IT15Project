@model IEnumerable<EventSphere.Web.Models.Invoice>
@{
    ViewData["Title"] = "Billing";
    var statuses = (string[])ViewData["Statuses"]!;
    var status = ViewData["Status"] as string;
}

<div class="page-heading">
    <h1>Billing &amp; Invoices</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Invoice</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">Total Billed</div>
            <div class="stat-value text-primary">@StatusHelper.Money((decimal)ViewData["TotalBilled"])</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">Total Collected</div>
            <div class="stat-value text-success">@StatusHelper.Money((decimal)ViewData["TotalPaid"])</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">Outstanding</div>
            <div class="stat-value text-danger">@StatusHelper.Money((decimal)ViewData["TotalBilled"] - (decimal)ViewData["TotalPaid"])</div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(status) ? "btn-secondary" : "btn-outline-secondary")">All</a>
                @foreach (var s in statuses)
                {
                    <a asp-action="Index" asp-route-status="@s" class="btn btn-sm @(status == s ? "btn-secondary" : "btn-outline-secondary")">@s</a>
                }
            </div>
            <div class="col-md-3 ms-auto">
                <select name="clientId" class="form-select form-select-sm" asp-items="ViewBag.Clients" onchange="this.form.submit()">
                    <option value="">All Clients</option>
                </select>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Invoice #</th>
                    <th>Client</th>
                    <th>Event</th>
                    <th>Issued</th>
                    <th>Due</th>
                    <th class="text-end">Amount</th>
                    <th class="text-end">Balance</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inv in Model)
                {
                    <tr>
                        <td class="fw-semibold"><a asp-action="Details" asp-route-id="@inv.Id" class="text-decoration-none">@inv.InvoiceNumber</a></td>
                        <td>@inv.Client?.CompanyName</td>
                        <td>@inv.Event?.Name ?? "-"</td>
                        <td>@inv.IssueDate.ToString("MMM dd, yyyy")</td>
                        <td>@inv.DueDate.ToString("MMM dd, yyyy")</td>
                        <td class="text-end">@StatusHelper.Money(inv.Amount)</td>
                        <td class="text-end fw-semibold @(inv.Balance > 0 ? "text-danger" : "text-success")">@StatusHelper.Money(inv.Balance)</td>
                        <td><span class="badge @StatusHelper.Badge(inv.Status)">@inv.Status</span></td>
                        <td class="text-end">
                            @if (inv.Balance > 0)
                            {
                                <a asp-action="RecordPayment" asp-route-id="@inv.Id" class="btn btn-sm btn-outline-success">Payment</a>
                            }
                            <a asp-action="Edit" asp-route-id="@inv.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@inv.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
