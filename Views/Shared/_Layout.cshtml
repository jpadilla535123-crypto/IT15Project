<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventSphere</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EventSphere.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        string Active(string c) => currentController == c ? "active" : "";
    }
    <div class="app-shell">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <div class="brand-logo">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                </div>
                <span class="brand-name">EventSphere</span>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section">Overview</div>
                <a class="nav-item @Active("Home")" asp-controller="Home" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                    Dashboard
                </a>

                <div class="nav-section">CRM</div>
                <a class="nav-item @Active("Leads")" asp-controller="Leads" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></svg>
                    Lead Management
                </a>
                <a class="nav-item @Active("Clients")" asp-controller="Clients" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    Client Management
                </a>

                <div class="nav-section">Operations</div>
                <a class="nav-item @Active("Events")" asp-controller="Events" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/></svg>
                    Event Management
                </a>
                <a class="nav-item @Active("Calendar")" asp-controller="Calendar" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
                    Event Calendar
                </a>
                <a class="nav-item @Active("Assignments")" asp-controller="Assignments" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><path d="m17 11 2 2 4-4"/></svg>
                    Employee Assignments
                </a>

                <div class="nav-section">Resources</div>
                <a class="nav-item @Active("Venues")" asp-controller="Venues" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    Venue Management
                </a>
                <a class="nav-item @Active("Suppliers")" asp-controller="Suppliers" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                    Supplier Management
                </a>
                <a class="nav-item @Active("Employees")" asp-controller="Employees" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    Employee Management
                </a>

                <div class="nav-section">Finance</div>
                <a class="nav-item @Active("Budgets")" asp-controller="Budgets" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4z"/></svg>
                    Budget Management
                </a>
                <a class="nav-item @Active("Invoices")" asp-controller="Invoices" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1-2-1z"/><path d="M8 7h8"/><path d="M8 11h8"/><path d="M8 15h5"/></svg>
                    Billing
                </a>

                <div class="nav-section">Insights</div>
                <a class="nav-item @Active("Reports")" asp-controller="Reports" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>
                    Reports
                </a>
            </nav>

            <div class="sidebar-profile">
                <div class="profile-avatar">JD</div>
                <div>
                    <div class="profile-name">John Doe</div>
                    <div class="profile-role">UI/UX Designer</div>
                </div>
                <span class="profile-caret">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                </span>
            </div>
        </aside>

        <div class="main-area">
            <header class="topbar">
                <div class="topbar-left">
                    @if (currentController != "Home")
                    {
                        <form class="search-bar" method="get" asp-controller="Events" asp-action="Index">
                            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                            <input type="search" name="search" placeholder="Search for event, date, etc" aria-label="Search" />
                        </form>
                    }
                </div>
                <div class="topbar-actions">
                    <span class="utility-item">
                        <svg class="util-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                        <span>@DateTime.UtcNow.AddHours(8).ToString("hh:mm tt") (PHT; UTC +8)</span>
                        <svg class="util-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                    </span>
                    <span class="utility-item lang">
                        <span class="flag">🇬🇧</span> English
                        <svg class="util-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                    </span>
                    <div class="btn-group">
                        <button class="icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                            <span class="notif-badge">4</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end notify-menu">
                            <div class="dropdown-header">Notifications</div>
                            <a class="notify-item" asp-controller="Calendar" asp-action="Index">
                                <span class="n-icon n-icon-amber"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg></span>
                                <span>
                                    <div class="n-title">Luna Events Gala Night</div>
                                    <div class="n-sub">Event is happening today</div>
                                </span>
                                <span class="n-time">Today</span>
                            </a>
                            <a class="notify-item" asp-controller="Budgets" asp-action="Index">
                                <span class="n-icon n-icon-red"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg></span>
                                <span>
                                    <div class="n-title">Budget overrun</div>
                                    <div class="n-sub">Garcia Wedding over planned</div>
                                </span>
                                <span class="n-time">Yesterday</span>
                            </a>
                            <a class="notify-item" asp-controller="Leads" asp-action="Index">
                                <span class="n-icon n-icon-blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l2 2"/><circle cx="12" cy="12" r="10"/></svg></span>
                                <span>
                                    <div class="n-title">Lead follow-up due</div>
                                    <div class="n-sub">3 leads need attention</div>
                                </span>
                                <span class="n-time">2d</span>
                            </a>
                        </div>
                    </div>
                    <div class="btn-group">
                        <button class="icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Messages">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end notify-menu">
                            <div class="dropdown-header">Messages</div>
                            <a class="notify-item" asp-controller="Leads" asp-action="Index">
                                <span class="n-icon n-icon-purple"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></span>
                                <span>
                                    <div class="n-title">New lead from TechCorp</div>
                                    <div class="n-sub">Product Launch inquiry</div>
                                </span>
                                <span class="n-time">2m</span>
                            </a>
                            <a class="notify-item" asp-controller="Invoices" asp-action="Index">
                                <span class="n-icon n-icon-green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                                <span>
                                    <div class="n-title">Invoice INV-0001 paid</div>
                                    <div class="n-sub">Payment received</div>
                                </span>
                                <span class="n-time">1h</span>
                            </a>
                            <a class="notify-item" asp-controller="Assignments" asp-action="Index">
                                <span class="n-icon n-icon-blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><path d="m17 11 2 2 4-4"/></svg></span>
                                <span>
                                    <div class="n-title">New assignment confirmed</div>
                                    <div class="n-sub">Luna Gala - AV Crew</div>
                                </span>
                                <span class="n-time">3h</span>
                            </a>
                        </div>
                    </div>
                </div>
            </header>
            <main class="content pb-4">
                @RenderBody()
            </main>
            <footer class="app-footer">
                &copy; @DateTime.Now.Year EventSphere - Event Management ERP &amp; CRM
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
