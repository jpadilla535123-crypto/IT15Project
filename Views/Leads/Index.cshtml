@model IEnumerable<EventSphere.Web.Models.Lead>
@{
    ViewData["Title"] = "Lead Management";
    var statuses = (string[])ViewData["Statuses"]!;
    var status = ViewData["Status"] as string;
    var search = ViewData["Search"] as string;
}

<div class="page-heading">
    <h1>Lead Management</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Lead</a>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(status) ? "btn-secondary" : "btn-outline-secondary")">All</a>
                @foreach (var s in statuses)
                {
                    <a asp-action="Index" asp-route-status="@s" asp-route-search="@search" class="btn btn-sm @(status == s ? "btn-secondary" : "btn-outline-secondary")">@s</a>
                }
            </div>
            <div class="col-auto ms-auto">
                <div class="input-group input-group-sm">
                    <input name="search" value="@search" class="form-control" placeholder="Search leads..." />
                    <button class="btn btn-outline-secondary" type="submit">Search</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Company</th>
                    <th>Contact</th>
                    <th>Event Type</th>
                    <th>Estimated Budget</th>
                    <th>Source</th>
                    <th>Created</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lead in Model)
                {
                    <tr>
                        <td class="fw-semibold"><a asp-action="Details" asp-route-id="@lead.Id" class="text-decoration-none">@lead.CompanyName</a></td>
                        <td>
                            <div>@lead.ContactName</div>
                            <div class="text-muted small">@lead.Email</div>
                        </td>
                        <td>@lead.EventType</td>
                        <td>@StatusHelper.Money(lead.EstimatedBudget)</td>
                        <td>@lead.Source</td>
                        <td>@lead.CreatedDate.ToString("MMM dd, yyyy")</td>
                        <td><span class="badge @StatusHelper.Badge(lead.Status)">@lead.Status</span></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@lead.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@lead.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
