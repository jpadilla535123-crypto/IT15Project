@model EventSphere.Web.Models.Lead
@{
    ViewData["Title"] = "Lead Details";
}

<div class="page-heading">
    <h1>@Model.CompanyName</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Lead Information</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8"><span class="badge @StatusHelper.Badge(Model.Status)">@Model.Status</span></dd>
                    <dt class="col-sm-4">Contact Person</dt>
                    <dd class="col-sm-8">@Model.ContactName</dd>
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">@Model.Phone</dd>
                    <dt class="col-sm-4">Source</dt>
                    <dd class="col-sm-8">@Model.Source</dd>
                    <dt class="col-sm-4">Event Type</dt>
                    <dd class="col-sm-8">@Model.EventType</dd>
                    <dt class="col-sm-4">Estimated Budget</dt>
                    <dd class="col-sm-8">@StatusHelper.Money(Model.EstimatedBudget)</dd>
                    <dt class="col-sm-4">Created</dt>
                    <dd class="col-sm-8">@Model.CreatedDate.ToString("MMM dd, yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Notes</div>
            <div class="card-body">
                <p class="mb-0">@(string.IsNullOrEmpty(Model.Notes) ? "No notes recorded." : Model.Notes)</p>
            </div>
        </div>
    </div>
</div>
