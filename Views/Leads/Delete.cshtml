@model EventSphere.Web.Models.Lead
@{
    ViewData["Title"] = "Delete Lead";
}

<div class="page-heading">
    <h1>Delete Lead</h1>
</div>

<div class="card border-danger">
    <div class="card-body">
        <p class="mb-3">Are you sure you want to delete the lead for <strong>@Model.CompanyName</strong>? This action cannot be undone.</p>
        <dl class="row mb-3">
            <dt class="col-sm-3">Contact</dt>
            <dd class="col-sm-9">@Model.ContactName (@Model.Email)</dd>
            <dt class="col-sm-3">Event Type</dt>
            <dd class="col-sm-9">@Model.EventType</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9"><span class="badge @StatusHelper.Badge(Model.Status)">@Model.Status</span></dd>
        </dl>
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
