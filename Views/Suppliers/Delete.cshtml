@model EventSphere.Web.Models.Supplier
@{
    ViewData["Title"] = "Delete Supplier";
}

<div class="page-heading">
    <h1>Delete Supplier</h1>
</div>

<div class="card border-danger">
    <div class="card-body">
        <p class="mb-3">Are you sure you want to delete <strong>@Model.Name</strong>? This action cannot be undone.</p>
        <dl class="row mb-3">
            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Category</dd>
            <dt class="col-sm-3">Contact</dt>
            <dd class="col-sm-9">@Model.ContactPerson (@Model.Email)</dd>
        </dl>
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
