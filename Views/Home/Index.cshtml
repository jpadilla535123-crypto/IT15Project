@{
    ViewData["Title"] = "Dashboard";
    var calEvents = (Dictionary<int, List<Event>>)ViewData["CalendarEvents"]!;
    var daysInMonth = (int)ViewData["DaysInMonth"]!;
    var startOffset = (int)ViewData["StartOffset"]!;
    var monthEvents = (List<Event>)ViewData["MonthEvents"]!;
    var monthTotal = (int)ViewData["MonthEventCount"]!;
    var monthDone = (int)ViewData["MonthCompleted"]!;
    var gaugePct = monthTotal > 0 ? (int)((double)monthDone / monthTotal * 100) : 0;
    var gaugeR = 46.0;
    var gaugeC = 2 * Math.PI * gaugeR;
    var gaugeDash = gaugePct * gaugeC / 100;
}

<div class="page-heading">
    <h1>Dashboard</h1>
</div>

<div class="dash-metrics">
    <div class="metric-card">
        <div class="metric-body">
            <div class="metric-icon metric-red">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div class="metric-text">
                <div class="metric-label">Clients</div>
                <div class="metric-value">@ViewData["ClientCount"]</div>
            </div>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-body">
            <div class="metric-icon metric-blue">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>
            </div>
            <div class="metric-text">
                <div class="metric-label">Events</div>
                <div class="metric-value">@ViewData["EventCount"]</div>
            </div>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-body">
            <div class="metric-icon metric-purple">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
            </div>
            <div class="metric-text">
                <div class="metric-label">Revenue</div>
                <div class="metric-value">@StatusHelper.Money((decimal)ViewData["RevenueTotal"])</div>
            </div>
        </div>
    </div>

    <div class="metric-card">
        <div class="metric-body">
            <div class="metric-icon metric-green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/></svg>
            </div>
            <div class="metric-text">
                <div class="metric-label">Leads</div>
                <div class="metric-value">@ViewData["LeadCount"]</div>
            </div>
        </div>
    </div>
</div>

<div class="dash-mid">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>@ViewData["MonthName"]</span>
        </div>
        <div class="mini-cal">
            <div class="cal-weekdays">
                @foreach (var d in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
                {
                    <span>@d</span>
                }
            </div>
            <div class="cal-grid">
                @for (var i = 0; i < startOffset + daysInMonth; i++)
                {
                    var day = i - startOffset + 1;
                    var isToday = day == DateTime.Today.Day;
                    if (day < 1)
                    {
                        <div class="cal-cell other-month"></div>
                    }
                    else if (day > daysInMonth)
                    {
                        <div class="cal-cell other-month"></div>
                    }
                    else
                    {
                        <div class="cal-cell @(isToday ? "today" : "")">
                            <span class="day-num">@day</span>
                            @if (calEvents.TryGetValue(day, out var events))
                            {
                                foreach (var ev in events.Take(3))
                                {
                                    <a class="mini-event-label @(ev.Status == "Completed" ? "completed" : ev.Status == "Cancelled" ? "cancelled" : "")"
                                       asp-controller="Events" asp-action="Details" asp-route-id="@ev.Id" title="@ev.Name">@ev.Name</a>
                                }
                                if (events.Count > 3)
                                {
                                    <span class="mini-event-more">+@(events.Count - 3) more</span>
                                }
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>This Month Events</span>
            <button class="kebab" type="button" aria-label="More options">
                <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="19" cy="12" r="1.7"/></svg>
            </button>
        </div>
        <div class="card-body">
            <div class="gauge-wrap">
                <svg class="gauge-svg" viewBox="0 0 120 120">
                    <circle cx="60" cy="60" r="37" fill="none" stroke="rgba(138,82,243,0.18)" stroke-width="1" />
                    <circle cx="60" cy="60" r="46" fill="none" stroke="#2A2B31" stroke-width="10" />
                    <circle cx="60" cy="60" r="46" fill="none" stroke="#8A52F3" stroke-width="10"
                            stroke-linecap="round" stroke-dasharray="@(gaugeDash.ToString("0.00")) @(gaugeC.ToString("0.00"))"
                            transform="rotate(-90 60 60)" />
                </svg>
                <div class="gauge-center">
                    <div class="gauge-value">@monthTotal</div>
                    <div class="gauge-label">@ViewData["MonthName"]</div>
                </div>
            </div>
            <div class="text-center mt-3" style="font-size:12.5px;color:#9CA3AF;">
                @monthDone of @monthTotal completed
            </div>
        </div>
    </div>
</div>

<div class="dash-bottom">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Suppliers</span>
            <a asp-controller="Suppliers" asp-action="Index" class="btn btn-sm btn-outline-secondary">View All</a>
        </div>
        <div class="supplier-list">
            @foreach (var s in (List<Supplier>)ViewData["Suppliers"]!)
            {
                <div class="supplier-item">
                    <div class="supplier-avatar">@s.Name[0]</div>
                    <div>
                        <div class="supplier-name">@s.Name</div>
                        <div class="supplier-cat">@s.Category</div>
                    </div>
                    <div class="supplier-right">
                        <span class="supplier-rating">★ @s.Rating</span>
                        <div>rating</div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Upcoming Events</span>
            <button class="kebab" type="button" aria-label="More options">
                <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="19" cy="12" r="1.7"/></svg>
            </button>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Client</th>
                        <th>Venue</th>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in (List<Event>)ViewData["UpcomingEvents"]!)
                    {
                        <tr>
                            <td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.Id" class="fw-semibold text-decoration-none">@e.Name</a></td>
                            <td>@(e.Client?.CompanyName ?? "-")</td>
                            <td>@(e.Venue?.Name ?? "-")</td>
                            <td>@e.StartDate.ToString("MMM dd, yyyy")</td>
                            <td><span class="badge @StatusHelper.Badge(e.Status)">@e.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
