@model EventSphere.Web.Models.Event
@{
    ViewData["Title"] = "Delete Event";
}

<div class="page-heading">
    <h1>Delete Event</h1>
</div>

<div class="card border-danger">
    <div class="card-body">
        <p class="mb-3">Are you sure you want to delete <strong>@Model.Name</strong>? All associated budgets, assignments, and schedules will also be removed.</p>
        <dl class="row mb-3">
            <dt class="col-sm-3">Client</dt>
            <dd class="col-sm-9">@Model.Client?.CompanyName ?? "-"</dd>
            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.EventType</dd>
            <dt class="col-sm-3">Schedule</dt>
            <dd class="col-sm-9">@Model.StartDate.ToString("MMM dd, yyyy") - @Model.EndDate.ToString("MMM dd, yyyy")</dd>
        </dl>
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
