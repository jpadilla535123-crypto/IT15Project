@model EventSphere.Web.Models.Event
@{
    ViewData["Title"] = "Event Details";
    var planned = Model.Budgets.Sum(b => b.PlannedAmount);
    var actual = Model.Budgets.Sum(b => b.ActualAmount);
    var billed = Model.Invoices.Sum(i => i.Amount);
}

<div class="page-heading">
    <h1>@Model.Name</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">Total Budget</div>
            <div class="stat-value text-primary">@StatusHelper.Money(planned)</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">Actual Spent</div>
            <div class="stat-value text-warning">@StatusHelper.Money(actual)</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">Staff Assigned</div>
            <div class="stat-value">@Model.Assignments.Count</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-label">Total Billed</div>
            <div class="stat-value text-success">@StatusHelper.Money(billed)</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header">Event Information</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Type</dt>
                    <dd class="col-sm-7">@Model.EventType</dd>
                    <dt class="col-sm-5">Status</dt>
                    <dd class="col-sm-7"><span class="badge @StatusHelper.Badge(Model.Status)">@Model.Status</span></dd>
                    <dt class="col-sm-5">Start</dt>
                    <dd class="col-sm-7">@Model.StartDate.ToString("MMM dd, yyyy")</dd>
                    <dt class="col-sm-5">End</dt>
                    <dd class="col-sm-7">@Model.EndDate.ToString("MMM dd, yyyy")</dd>
                    <dt class="col-sm-5">Client</dt>
                    <dd class="col-sm-7">
                        @if (Model.Client != null)
                        {
                            <a asp-controller="Clients" asp-action="Details" asp-route-id="@Model.Client.Id" class="text-decoration-none">@Model.Client.CompanyName</a>
                        }
                        else
                        {
                            <text>-</text>
                        }
                    </dd>
                    <dt class="col-sm-5">Venue</dt>
                    <dd class="col-sm-7">@Model.Venue?.Name ?? "-"</dd>
                </dl>
                <hr />
                <p class="mb-0">@(string.IsNullOrEmpty(Model.Description) ? "No description." : Model.Description)</p>
            </div>
        </div>
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Budget</span>
                <a asp-controller="Budgets" asp-action="Create" asp-route-eventId="@Model.Id" class="btn btn-sm btn-primary">+ Add</a>
            </div>
            <div class="card-body p-0">
                @if (Model.Budgets.Count == 0)
                {
                    <p class="text-muted p-3 mb-0">No budget lines yet.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>Category</th><th class="text-end">Planned</th><th class="text-end">Actual</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.Budgets)
                            {
                                <tr>
                                    <td>@b.Category</td>
                                    <td class="text-end">@StatusHelper.Money(b.PlannedAmount)</td>
                                    <td class="text-end">@StatusHelper.Money(b.ActualAmount)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Staff Assignments</span>
                <a asp-controller="Assignments" asp-action="Create" asp-route-eventId="@Model.Id" class="btn btn-sm btn-primary">+ Assign</a>
            </div>
            <div class="card-body p-0">
                @if (Model.Assignments.Count == 0)
                {
                    <p class="text-muted p-3 mb-0">No staff assigned.</p>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr><th>Employee</th><th>Role</th><th>Hours</th><th>Assigned</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Assignments)
                            {
                                <tr>
                                    <td>@a.Employee?.FullName</td>
                                    <td>@a.Role</td>
                                    <td>@a.Hours.ToString("0.#")</td>
                                    <td>@a.AssignedDate.ToString("MMM dd, yyyy")</td>
                                    <td><span class="badge @StatusHelper.Badge(a.Status)">@a.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">Invoices</div>
            <div class="card-body p-0">
                @if (Model.Invoices.Count == 0)
                {
                    <p class="text-muted p-3 mb-0">No invoices for this event.</p>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr><th>Invoice #</th><th>Issued</th><th class="text-end">Amount</th><th class="text-end">Paid</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in Model.Invoices)
                            {
                                <tr>
                                    <td><a asp-controller="Invoices" asp-action="Details" asp-route-id="@inv.Id" class="text-decoration-none">@inv.InvoiceNumber</a></td>
                                    <td>@inv.IssueDate.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end">@StatusHelper.Money(inv.Amount)</td>
                                    <td class="text-end">@StatusHelper.Money(inv.PaidAmount)</td>
                                    <td><span class="badge @StatusHelper.Badge(inv.Status)">@inv.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
