@model IEnumerable<EventSphere.Web.Models.Event>
@{
    ViewData["Title"] = "Events";
    var tab = (string)ViewData["Tab"]!;
    var range = ViewData["Range"] as string;
    var rangeLabel = (string)ViewData["RangeLabel"]!;
    var search = ViewData["Search"] as string;
    var page = (int)ViewData["Page"]!;
    var totalPages = (int)ViewData["TotalPages"]!;
    var total = (int)ViewData["TotalCount"]!;
    var pageStart = (int)ViewData["PageStart"]!;
    var pageEnd = (int)ViewData["PageEnd"]!;
    var fromDate = ViewData["FromDate"] as string;
    var toDate = ViewData["ToDate"] as string;
    var rowNum = pageStart;
}

<div class="page-heading">
    <h1>Events</h1>
    <a asp-action="Create" class="btn btn-primary fw-semibold">+ CREATE EVENT</a>
</div>

<div class="dash-metrics ev-metrics">
    <div class="metric-accent accent-purple">
        <div class="metric-count">@ViewData["TotalEvents"]</div>
        <div class="metric-label">Total Events</div>
    </div>
    <div class="metric-accent accent-green">
        <div class="metric-count">@ViewData["CompletedCount"]</div>
        <div class="metric-label">Completed Events</div>
    </div>
    <div class="metric-accent accent-amber">
        <div class="metric-count">@ViewData["InProcessCount"]</div>
        <div class="metric-label">Pending</div>
    </div>
</div>

<div class="card ev-table-card">
    <div class="card-body p-0">
        <div class="table-toolbar">
            <div class="filter-tabs">
                <a class="filter-tab @(tab == "all" ? "active" : "")"
                   asp-action="Index" asp-route-tab="all" asp-route-range="@range" asp-route-search="@search">ALL</a>
                <a class="filter-tab @(tab == "upcoming" ? "active" : "")"
                   asp-action="Index" asp-route-tab="upcoming" asp-route-range="@range" asp-route-search="@search">Upcoming</a>
                <a class="filter-tab @(tab == "completed" ? "active" : "")"
                   asp-action="Index" asp-route-tab="completed" asp-route-range="@range" asp-route-search="@search">Completed</a>
            </div>

            <div class="date-filter">
                <div class="dropdown">
                    <button class="date-pill" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        @rangeLabel
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end date-menu">
                        <a class="dropdown-item @(string.IsNullOrEmpty(range) ? "active" : "")"
                           asp-action="Index" asp-route-tab="@tab" asp-route-search="@search">All Dates</a>
                        <a class="dropdown-item @(range == "today" ? "active" : "")"
                           asp-action="Index" asp-route-tab="@tab" asp-route-range="today" asp-route-search="@search">Today</a>
                        <a class="dropdown-item @(range == "yesterday" ? "active" : "")"
                           asp-action="Index" asp-route-tab="@tab" asp-route-range="yesterday" asp-route-search="@search">Yesterday</a>
                        <a class="dropdown-item @(range == "last7" ? "active" : "")"
                           asp-action="Index" asp-route-tab="@tab" asp-route-range="last7" asp-route-search="@search">Last 7 Days</a>
                        <a class="dropdown-item @(range == "last30" ? "active" : "")"
                           asp-action="Index" asp-route-tab="@tab" asp-route-range="last30" asp-route-search="@search">Last 30 Days</a>
                        <a class="dropdown-item @(range == "thismonth" ? "active" : "")"
                           asp-action="Index" asp-route-tab="@tab" asp-route-range="thismonth" asp-route-search="@search">This Month</a>
                        <a class="dropdown-item @(range == "lastmonth" ? "active" : "")"
                           asp-action="Index" asp-route-tab="@tab" asp-route-range="lastmonth" asp-route-search="@search">Last Month</a>
                        <div class="dropdown-divider"></div>
                        <form method="get" class="p-2 date-custom">
                            <input type="hidden" name="tab" value="@tab" />
                            <input type="hidden" name="search" value="@search" />
                            <input type="hidden" name="range" value="custom" />
                            <div class="d-flex gap-2 mb-2">
                                <input type="date" name="from" class="form-control form-control-sm" value="@fromDate" />
                                <input type="date" name="to" class="form-control form-control-sm" value="@toDate" />
                            </div>
                            <button class="btn btn-sm btn-primary w-100">Apply Range</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover ev-table mb-0">
                <thead>
                    <tr>
                        <th class="col-check"><input type="checkbox" class="form-check-input" /></th>
                        <th>#</th>
                        <th>Event Name</th>
                        <th>Client</th>
                        <th>Venue</th>
                        <th>Type</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">No events found.</td>
                        </tr>
                    }
                    @foreach (var evt in Model)
                    {
                        <tr>
                            <td class="col-check"><input type="checkbox" class="form-check-input" /></td>
                            <td class="text-muted">@rowNum</td>
                            <td class="fw-semibold"><a asp-action="Details" asp-route-id="@evt.Id" class="text-decoration-none">@evt.Name</a></td>
                            <td>@(evt.Client?.CompanyName ?? "-")</td>
                            <td>@(evt.Venue?.Name ?? "-")</td>
                            <td>@evt.EventType</td>
                            <td>@evt.StartDate.ToString("MMM dd, yyyy")</td>
                            <td><span class="badge @StatusHelper.Badge(evt.Status)">@evt.Status</span></td>
                            <td class="text-end">
                                @if (evt.Status == "Pending")
                                {
                                    <a asp-action="Edit" asp-route-id="@evt.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>
                        </tr>
                        rowNum++;
                    }
                </tbody>
            </table>
        </div>

        <div class="table-footer">
            <div class="text-muted">Showing @pageStart&ndash;@pageEnd of @total events</div>
            @if (totalPages > 1)
            {
                <nav>
                    <ul class="pagination mb-0">
                        <li class="page-item @(page <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(page - 1)" asp-route-tab="@tab" asp-route-range="@range" asp-route-search="@search">Previous</a>
                        </li>
                        @for (var p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == page ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-tab="@tab" asp-route-range="@range" asp-route-search="@search">@p</a>
                            </li>
                        }
                        <li class="page-item @(page >= totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(page + 1)" asp-route-tab="@tab" asp-route-range="@range" asp-route-search="@search">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
