@model EventSphere.Web.Models.Budget
@{
    ViewData["Title"] = "Edit Budget Line";
    var categories = (string[])ViewData["Categories"]!;
}

<div class="page-heading">
    <h1>Edit Budget Line</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="EventId" class="form-label"></label>
                        <select asp-for="EventId" class="form-select" asp-items="ViewBag.EventList">
                            <option value="">-- Select Event --</option>
                        </select>
                        <span asp-validation-for="EventId" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Category" class="form-label"></label>
                        <select asp-for="Category" class="form-select" asp-items="@(new SelectList(categories))"></select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="PlannedAmount" class="form-label"></label>
                        <input asp-for="PlannedAmount" class="form-control" />
                        <span asp-validation-for="PlannedAmount" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="ActualAmount" class="form-label"></label>
                        <input asp-for="ActualAmount" class="form-control" />
                        <span asp-validation-for="ActualAmount" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-12">
                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
