@model EventSphere.Web.Models.Client
@{
    ViewData["Title"] = "Client Details";
}

<div class="page-heading">
    <h1>@Model.CompanyName</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header">Client Information</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Contact Person</dt>
                    <dd class="col-sm-8">@Model.ContactPerson</dd>
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">@Model.Phone</dd>
                    <dt class="col-sm-4">Address</dt>
                    <dd class="col-sm-8">@Model.Address</dd>
                    <dt class="col-sm-4">Type</dt>
                    <dd class="col-sm-8">@Model.ClientType</dd>
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8"><span class="badge @StatusHelper.Badge(Model.Status)">@Model.Status</span></dd>
                    <dt class="col-sm-4">Date of Inquiry</dt>
                    <dd class="col-sm-8">@Model.DateOfInquiry.ToString("MMM dd, yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card mb-3">
            <div class="card-header">Events</div>
            <div class="card-body p-0">
                @if (Model.Events.Count == 0)
                {
                    <p class="text-muted p-3 mb-0">No events recorded.</p>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr><th>Event</th><th>Type</th><th>Date</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var e in Model.Events)
                            {
                                <tr>
                                    <td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.Id" class="text-decoration-none">@e.Name</a></td>
                                    <td>@e.EventType</td>
                                    <td>@e.StartDate.ToString("MMM dd, yyyy")</td>
                                    <td><span class="badge @StatusHelper.Badge(e.Status)">@e.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
        <div class="card">
            <div class="card-header">Billing History</div>
            <div class="card-body p-0">
                @if (Model.Invoices.Count == 0)
                {
                    <p class="text-muted p-3 mb-0">No invoices recorded.</p>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr><th>Invoice #</th><th>Issued</th><th>Amount</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in Model.Invoices)
                            {
                                <tr>
                                    <td><a asp-controller="Invoices" asp-action="Details" asp-route-id="@inv.Id" class="text-decoration-none">@inv.InvoiceNumber</a></td>
                                    <td>@inv.IssueDate.ToString("MMM dd, yyyy")</td>
                                    <td>@StatusHelper.Money(inv.Amount)</td>
                                    <td><span class="badge @StatusHelper.Badge(inv.Status)">@inv.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
