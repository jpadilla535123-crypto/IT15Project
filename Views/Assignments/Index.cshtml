@model IEnumerable<EventSphere.Web.Models.EventAssignment>
@{
    ViewData["Title"] = "Employee Assignments";
    var statuses = (string[])ViewData["Statuses"]!;
    var status = ViewData["Status"] as string;
}

<div class="page-heading">
    <h1>Employee Assignments</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Assignment</a>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(status) ? "btn-secondary" : "btn-outline-secondary")">All</a>
                @foreach (var s in statuses)
                {
                    <a asp-action="Index" asp-route-status="@s" class="btn btn-sm @(status == s ? "btn-secondary" : "btn-outline-secondary")">@s</a>
                }
            </div>
            <div class="col-md-2">
                <select name="eventId" class="form-select form-select-sm" asp-items="ViewBag.Events" onchange="this.form.submit()">
                    <option value="">All Events</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="employeeId" class="form-select form-select-sm" asp-items="ViewBag.Employees" onchange="this.form.submit()">
                    <option value="">All Employees</option>
                </select>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Employee</th>
                    <th>Role</th>
                    <th class="text-end">Hours</th>
                    <th>Assigned</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td><a asp-controller="Events" asp-action="Details" asp-route-id="@a.EventId" class="text-decoration-none fw-semibold">@a.Event?.Name</a></td>
                        <td>@a.Employee?.FullName</td>
                        <td>@a.Role</td>
                        <td class="text-end">@a.Hours.ToString("0.#")</td>
                        <td>@a.AssignedDate.ToString("MMM dd, yyyy")</td>
                        <td><span class="badge @StatusHelper.Badge(a.Status)">@a.Status</span></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@a.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
